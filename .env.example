# ==========================================
# EXENOS - Environment Configuration
# ==========================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Session
AUTH_SECRET=generate_a_random_32_character_secret_here_for_sessions
ENCRYPTION_SECRET=generate_a_32_byte_secret_key_for_aes_credentials

# Storage (google-drive | local)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# AI Provider (OmniRoute ONLY - Never Gemini / OpenRouter)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=default

# Market Data Providers
ALPHA_VANTAGE_API_KEY=

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
